{
  "version": 1,
  "id": "webgpu-field",
  "title": "Ion Field",
  "proves": [
    "a slow top-level-await boot is waited for rather than photographed black",
    "renderer.setAnimationLoop is paced because it rides the patched requestAnimationFrame",
    "the WebGPU backend is recognised everywhere isWebGLRenderer was the gate",
    "draw calls and GPU errors are reported for a WebGPU page",
    "capture reads a WebGPU canvas"
  ],
  "shape": {
    "entry": "index.html",
    "main": "src/main.js",
    "build": null,
    "install": null,
    "own": true,
    "kind": "three-modules",
    "serve": "."
  },
  "addsAtLeast": ["src/studio.js", "src/studio.d.ts", "CLAUDE.md", "NOTES.md", "studio.json", ".gitignore", ".git"],
  "neverAdded": ["index.html", "src/main.js", "docs/CONTRACT.md"],
  "edits": "none",
  "contract": "attached",
  "needsNodeModules": false,
  "backend": "webgpu",
  "app": {
    "kind": "graphics",
    "keyboardMove": true
  },
  "setup": null,
  "cameras": ["default"],
  "expectWarnings": [],
  "allowWarnings": [],
  "delta": [],
  "deterministic": true,
  "readyBudgetMs": 20000
}
